<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TeladanAmaliah" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Main Colors (Adapted for Dark Mode retaining Navy Identity) -->
        <item name="colorPrimary">@color/primary_navy</item>
        <item name="colorPrimaryDark">@color/primary_navy_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">#121212</item>
        <item name="colorSurface">#1E1E1E</item>
        <item name="colorOnSurface">#F5F5F5</item>
        <item name="android:textColorPrimary">#F5F5F5</item>
        <item name="android:textColorSecondary">#B0B0B0</item>
        
        <!-- Shape Default Overrides -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.TeladanAmaliah.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.TeladanAmaliah.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.TeladanAmaliah.LargeComponent</item>
        
        <!-- Default Component Styles -->
        <item name="materialCardViewStyle">@style/Widget.TeladanAmaliah.CardView</item>
        <item name="materialButtonStyle">@style/Widget.TeladanAmaliah.Button</item>
    </style>

    <!-- Shapes -->
    <style name="ShapeAppearance.TeladanAmaliah.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    
    <style name="ShapeAppearance.TeladanAmaliah.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    
    <style name="ShapeAppearance.TeladanAmaliah.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- CardView Base Style -->
    <style name="Widget.TeladanAmaliah.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardBackgroundColor">#1E1E1E</item>
    </style>

    <!-- Button Base Style -->
    <style name="Widget.TeladanAmaliah.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>